{
  "name": "harness-alchemist",
  "version": "0.1.10",
  "description": "Scaffold, validate, and publish portable coding-agent plugins across Claude Code, Codex, OpenCode, Antigravity, and DeepSeek Harness.",
  "type": "module",
  "bin": {
    "harness-alchemist": "bin/harness-alchemist.mjs"
  },
  "main": "./dist/opencode.js",
  "types": "./dist/opencode.d.ts",
  "exports": {
    ".": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./deepseek": {
      "types": "./dist/deepseek.d.ts",
      "import": "./dist/deepseek.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "skills",
    "alchemy.json",
    "alchemy.schema.json",
    "cordis.patch.yml",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    "mcp.json",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:adapters && npm run build:native",
    "build:adapters": "tsc -p tsconfig.json",
    "build:native": "cargo build --release --locked",
    "check": "tsc -p tsconfig.json --noEmit && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
    "test": "npm run build && cargo test --locked && node --test tests/*.test.mjs",
    "sync": "node .agents/skills/develop-harness-alchemist/scripts/sync-metadata.mjs",
    "validate": "node bin/harness-alchemist.mjs validate .",
    "stage:native": "node bin/harness-alchemist.mjs __stage-native-packages --output .native-packages",
    "pack:check": "node .agents/skills/develop-harness-alchemist/scripts/check-package.mjs",
    "verify": "npm run check && npm test && npm run validate && npm run pack:check",
    "prepack": "npm run verify",
    "prepublishOnly": "node -e \"console.error('Refusing to publish the source tree; publish the staged main package.'); process.exit(1)\""
  },
  "engines": {
    "node": ">=22.20.0",
    "bun": ">=1.2.0"
  },
  "keywords": [
    "agent-skill",
    "antigravity",
    "claude-code",
    "codex",
    "deepseek",
    "opencode",
    "scaffolding"
  ],
  "dependencies": {
    "@lunarmoon26/agent-skill-runtime": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@opencode-ai/plugin": "^1.18.21"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@opencode-ai/plugin": "^1.18.21",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "author": "Haochuan Zhang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunarmoon26/harness-alchemist.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
